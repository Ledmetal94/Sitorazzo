# =====================================================================
# SITORAZZO — environment variables for /api/generate-mockup pipeline
# Copy to .env.local for local dev. On Vercel, set in Project Settings.
# =====================================================================

# ---------- Anthropic (Claude API) ----------
# AI copy generation (lib/anthropic.js).
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---------- Upstash Redis / Vercel KV ----------
# Stores mockup records + rate limiting (api/generate-mockup.js).
# Vercel: Project → Storage → Create KV → it auto-injects KV_REST_API_*
# Upstash direct: https://console.upstash.com → Create DB → REST API
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------- Vercel Blob ----------
# Stores uploaded logos (api/generate-mockup.js).
# Vercel: Project → Storage → Create Blob → it auto-injects BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=

# ---------- Inngest ----------
# Async job queue for AI copy + email (lib/inngest.js, api/inngest.js).
# Get keys: https://app.inngest.com → App "sitorazzo" → Settings → Keys
# After deploy, sync at: https://app.inngest.com → Apps → Sync → enter https://sitorazzo.it/api/inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---------- Resend (transactional email) ----------
# Mockup-ready email + future drip campaign (lib/email.js).
# Get key: https://resend.com/api-keys
# IMPORTANT: verify sitorazzo.it domain at https://resend.com/domains
# (add SPF + DKIM + DMARC DNS records — without verified domain, emails go to spam)
RESEND_API_KEY=
# Optional overrides — defaults work if you've verified sitorazzo.it on Resend:
# RESEND_FROM_EMAIL="Sitorazzo <hello@sitorazzo.it>"
# RESEND_REPLY_TO=info@sitorazzo.it

# ---------- Site URL ----------
# Used to build mockup links in emails. Override for staging/preview.
SITE_URL=https://sitorazzo.it
